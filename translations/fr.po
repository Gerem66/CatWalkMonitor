msgstr "Avancé"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Idle threshold:"
msgstr "Seuil d'inactivité :"

#: contents/ui/config/ConfigGeneral.qml contents/ui/main.qml
#, kde-format
msgctxt "a percentage"
msgid "%1%"
msgstr "%1 %"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "The cat sleeps while the usage it follows is under this value."
msgstr ""
"Le chat dort tant que l'utilisation qu'il suit reste sous cette valeur."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Walk below:"
msgstr "Marche en dessous de :"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"The cat walks while the usage it follows is under this value, and runs from "
"there on. At 0 it always runs."
msgstr ""
"Le chat marche tant que l'utilisation qu'il suit reste sous cette valeur, et "
"court à partir de celle-ci. À 0, il court toujours."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Frame rate:"
msgstr "Fréquence d'images :"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "frames per second"
msgid "%1 fps"
msgstr "%1 images/s"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"How many times per second the cat is drawn while it runs. A lower value is "
"less smooth and lighter on the system."
msgstr ""
"Nombre de fois par seconde où le chat est dessiné lorsqu'il court. Une "
"valeur plus basse est moins fluide et plus légère pour le système."

#: contents/ui/config/HighUsageChoice.qml
#, kde-format
msgid "Change color above"
msgstr "Changer de couleur au-delà de"

#: contents/ui/config/HighUsageChoice.qml
#, kde-format
msgctxt "@label unit after a number field"
msgid "%"
msgstr "%"

#: contents/ui/config/SizeChoice.qml
#, kde-format
msgctxt "@option:check the widget chooses the size"
msgid "Automatic"
msgstr "Automatique"

#: contents/ui/config/SizeChoice.qml
#, kde-format
msgctxt "@label unit after a number field"
msgid "px"
msgstr "px"

#: contents/ui/main.qml
#, kde-format
msgctxt "there is no reading for this value"
msgid "unavailable"
msgstr "indisponible"

#: contents/ui/main.qml
#, kde-format
