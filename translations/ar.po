#: contents/config/config.qml
#, kde-format
msgid "General"
msgstr "عامّ"

#: contents/ui/config/ColorChoice.qml
#, kde-format
msgctxt "@option:check use a color of one's own instead of the theme's"
msgid "Custom"
msgstr "مخصّص"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Display:"
msgstr "العرض:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Cat and values"
msgstr "القطّ والقيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Cat only"
msgstr "القطّ فقط"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Values only"
msgstr "القيم فقط"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Values:"
msgstr "القيم:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "CPU usage"
msgstr "استخدام المعالج"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "and temperature"
msgstr "ودرجة الحرارة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "GPU usage"
msgstr "استخدام معالج الرسوميات"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Memory usage"
msgstr "استخدام الذاكرة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"Only memory modules with a temperature sensor report one, which is common "
"with DDR5 and rare before. Nothing is shown otherwise."
msgstr ""
"لا تُبلّغ عن درجة الحرارة إلا وحدات الذاكرة المزوّدة بمستشعر حرارة، وهذا شائع "
"في DDR5 ونادر قبلها. وإلا فلن يُعرض شيء."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"With the cat alone, the selected values appear in its tooltip, and the cat "
"can follow them."
msgstr "عند عرض القطّ وحده، تظهر القيم المحدّدة في تلميحه، ويمكن للقطّ أن يتبعها."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "The cat follows:"
msgstr "القطّ يتبع:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "The highest of the selected values"
msgstr "أعلى القيم المحدّدة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "The average of the selected values"
msgstr "متوسّط القيم المحدّدة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Arrange the values:"
msgstr "ترتيب القيم:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Along the panel"
msgstr "على امتداد اللوحة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "In a row"
msgstr "في صفّ"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "In a column"
msgstr "في عمود"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Spacing:"
msgstr "التباعد:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "Cat"
msgstr "القطّ"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Position:"
msgstr "الموضع:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Before the values"
msgstr "قبل القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "After the values"
msgstr "بعد القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Above the values"
msgstr "فوق القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Below the values"
msgstr "تحت القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Size:"
msgstr "الحجم:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Color:"
msgstr "اللون:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the cat"
msgstr "لون القطّ"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "High usage:"
msgstr "الاستخدام المرتفع:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the cat at high usage"
msgstr "لون القطّ عند الاستخدام المرتفع"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "Values"
msgstr "القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the values"
msgstr "لون القيم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Icons:"
msgstr "الأيقونات:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Show an icon before each value"
msgstr "اعرض أيقونة قبل كلّ قيمة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Decimals:"
msgstr "المنازل العشرية:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Temperature spacing:"
msgstr "تباعد درجة الحرارة:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "CPU"
msgstr "المعالج"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the CPU value"
msgstr "لون قيمة المعالج"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the CPU value at high usage"
msgstr "لون قيمة المعالج عند الاستخدام المرتفع"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "GPU"
msgstr "معالج الرسوميات"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the GPU value"
msgstr "لون قيمة معالج الرسوميات"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the GPU value at high usage"
msgstr "لون قيمة معالج الرسوميات عند الاستخدام المرتفع"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "Memory"
msgstr "الذاكرة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the memory value"
msgstr "لون قيمة الذاكرة"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:window"
msgid "Color of the memory value at high usage"
msgstr "لون قيمة الذاكرة عند الاستخدام المرتفع"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "@title:group"
msgid "Advanced"
msgstr "متقدّم"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Idle threshold:"
msgstr "عتبة الخمول:"

#: contents/ui/config/ConfigGeneral.qml contents/ui/main.qml
#, kde-format
msgctxt "a percentage"
msgid "%1%"
msgstr "%1%"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "The cat sleeps while the usage it follows is under this value."
msgstr "ينام القطّ ما دام الاستخدام الذي يتبعه دون هذه القيمة."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Walk below:"
msgstr "المشي دون:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"The cat walks while the usage it follows is under this value, and runs from "
"there on. At 0 it always runs."
msgstr ""
"يمشي القطّ ما دام الاستخدام الذي يتبعه دون هذه القيمة، ويركض ابتداءً منها. عند "
"0 يركض دائمًا."

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid "Frame rate:"
msgstr "معدّل الإطارات:"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgctxt "frames per second"
msgid "%1 fps"
msgstr "%1 إطار/ث"

#: contents/ui/config/ConfigGeneral.qml
#, kde-format
msgid ""
"How many times per second the cat is drawn while it runs. A lower value is "
"less smooth and lighter on the system."
msgstr ""
"عدد مرّات رسم القطّ في الثانية أثناء حركته. القيمة الأدنى أقلّ سلاسة وأخفّ على "
"النظام."

#: contents/ui/config/HighUsageChoice.qml
#, kde-format
msgid "Change color above"
msgstr "غيّر اللون فوق"

#: contents/ui/config/HighUsageChoice.qml
#, kde-format
msgctxt "@label unit after a number field"
msgid "%"
msgstr "%"

#: contents/ui/config/SizeChoice.qml
#, kde-format
msgctxt "@option:check the widget chooses the size"
msgid "Automatic"
msgstr "تلقائي"

#: contents/ui/config/SizeChoice.qml
#, kde-format
msgctxt "@label unit after a number field"
msgid "px"
msgstr "بكسل"

#: contents/ui/main.qml
#, kde-format
msgctxt "there is no reading for this value"
msgid "unavailable"
msgstr "غير متاح"

#: contents/ui/main.qml
#, kde-format
msgctxt "a usage, then a temperature in degrees Celsius"
msgid "%1, %2 °C"
msgstr "%1، %2 °C"

#: contents/ui/main.qml
#, kde-format
msgid "CPU: %1"
msgstr "المعالج: %1"

#: contents/ui/main.qml
#, kde-format
msgid "GPU: %1"
msgstr "معالج الرسوميات: %1"

